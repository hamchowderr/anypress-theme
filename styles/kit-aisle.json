{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Aisle (clothing store)",
	"slug": "kit-aisle",
	"settings": {
		"color": {
			"palette": [
				{
					"color": "#33502f",
					"name": "Brand",
					"slug": "primary"
				},
				{
					"color": "#e2eadd",
					"name": "Brand soft",
					"slug": "primary-accent"
				},
				{
					"color": "#c9d8e3",
					"name": "Second brand",
					"slug": "primary-alt"
				},
				{
					"color": "#13283a",
					"name": "Second brand deep",
					"slug": "primary-alt-accent"
				},
				{
					"color": "#151515",
					"name": "Text",
					"slug": "main"
				},
				{
					"color": "#d9d7d1",
					"name": "Text soft",
					"slug": "main-accent"
				},
				{
					"color": "#fafaf7",
					"name": "Background",
					"slug": "base"
				},
				{
					"color": "#52524e",
					"name": "Muted text",
					"slug": "secondary"
				},
				{
					"color": "#efede7",
					"name": "Tint",
					"slug": "tertiary"
				},
				{
					"color": "#dedbd3",
					"name": "Border",
					"slug": "border-light"
				},
				{
					"color": "#2b2b2b",
					"name": "Border on dark",
					"slug": "border-dark"
				}
			]
		}
	},
	"styles": {
		"typography": {
			"fontFamily": "var:preset|font-family|manrope"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|schibsted-grotesk",
					"fontWeight": "700",
					"letterSpacing": "-0.02em",
					"lineHeight": "1.02"
				}
			},
			"button": {
				"border": {
					"radius": "0"
				},
				"typography": {
					"fontWeight": "700",
					"fontSize": "var:preset|font-size|base",
					"fontFamily": "var:preset|font-family|schibsted-grotesk",
					"letterSpacing": "0.01em"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|schibsted-grotesk",
					"fontWeight": "800",
					"letterSpacing": "-0.03em"
				}
			},
			"core/image": {
				"border": {
					"radius": "0"
				}
			},
			"core/quote": {
				"border": {
					"left": {
						"width": "0"
					}
				},
				"spacing": {
					"padding": {
						"left": "0"
					}
				}
			}
		}
	}
}
