{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Branch (franchise and multi-location)",
	"slug": "kit-branch",
	"settings": {
		"color": {
			"palette": [
				{
					"color": "#005f7a",
					"name": "Brand",
					"slug": "primary"
				},
				{
					"color": "#d4eef4",
					"name": "Brand soft",
					"slug": "primary-accent"
				},
				{
					"color": "#ffb547",
					"name": "Second brand",
					"slug": "primary-alt"
				},
				{
					"color": "#2b1600",
					"name": "Second brand deep",
					"slug": "primary-alt-accent"
				},
				{
					"color": "#0b2530",
					"name": "Text",
					"slug": "main"
				},
				{
					"color": "#d0dde2",
					"name": "Text soft",
					"slug": "main-accent"
				},
				{
					"color": "#fbfdfd",
					"name": "Background",
					"slug": "base"
				},
				{
					"color": "#45606b",
					"name": "Muted text",
					"slug": "secondary"
				},
				{
					"color": "#eaf5f7",
					"name": "Tint",
					"slug": "tertiary"
				},
				{
					"color": "#cfe3e8",
					"name": "Border",
					"slug": "border-light"
				},
				{
					"color": "#14394a",
					"name": "Border on dark",
					"slug": "border-dark"
				}
			]
		}
	},
	"styles": {
		"typography": {
			"fontFamily": "var:preset|font-family|figtree"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|bricolage-grotesque",
					"fontWeight": "800",
					"letterSpacing": "-0.03em",
					"lineHeight": "1"
				}
			},
			"button": {
				"border": {
					"radius": "var:preset|border-radius|full"
				},
				"typography": {
					"fontWeight": "700",
					"fontSize": "var:preset|font-size|base",
					"fontFamily": "var:preset|font-family|figtree"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|bricolage-grotesque",
					"fontWeight": "800",
					"letterSpacing": "-0.03em"
				}
			},
			"core/image": {
				"border": {
					"radius": "0"
				}
			},
			"core/quote": {
				"border": {
					"left": {
						"width": "0"
					}
				},
				"spacing": {
					"padding": {
						"left": "0"
					}
				}
			}
		}
	}
}
