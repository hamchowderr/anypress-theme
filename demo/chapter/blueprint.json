{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "AnyPress theme: Chapter demo",
		"author": "hamchowderr",
		"description": "An example website for courses and community, built with the AnyPress theme's Chapter kit, AnyPress Blocks and Fluent Forms."
	},
	"landingPage": "/",
