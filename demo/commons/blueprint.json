{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "AnyPress theme: Commons demo",
		"author": "hamchowderr",
		"description": "An example website for associations, chambers and churches, built with the AnyPress theme's Commons kit, AnyPress Blocks and Fluent Forms."
	},
	"landingPage": "/",
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
