{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "AnyPress theme: Byline demo",
		"author": "hamchowderr",
		"description": "An example website for blog and magazine, built with the AnyPress theme's Byline kit, AnyPress Blocks and Fluent Forms."
	},
	"landingPage": "/",
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"steps": [
		{
			"step": "login"
		},
		{
			"step": "installTheme",
			"themeData": {
				"resource": "url",
				"url": "https://api.anypress.io/branding/demo-files/anypress-theme.zip"
			},
			"options": {
				"activate": true,
				"targetFolderName": "anypress"
			},
			"progress": {
				"caption": "Setting up the design"
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://api.anypress.io/branding/demo-files/anypress-blocks.zip"
			},
			"options": {
				"activate": true,
				"targetFolderName": "anypress-blocks"
			},
			"progress": {
				"caption": "Adding the page sections"
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "wordpress.org/plugins",
				"slug": "fluentform"
			},
			"options": {
				"activate": true
			},
			"progress": {
				"caption": "Adding the forms"
			}
		},
		{
			"step": "mkdir",
			"path": "/wordpress/wp-content/themes/anypress/demo/byline/photos"
