{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "AnyPress theme: Frame demo",
		"author": "hamchowderr",
		"description": "An example website for creative portfolio, built with the AnyPress theme's Frame kit, AnyPress Blocks and Fluent Forms."
	},
	"landingPage": "/",
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
