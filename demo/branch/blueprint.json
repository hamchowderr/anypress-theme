{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "AnyPress theme: Branch demo",
		"author": "hamchowderr",
		"description": "An example website for franchise and multi-location, built with the AnyPress theme's Branch kit, AnyPress Blocks and Fluent Forms."
	},
	"landingPage": "/",
