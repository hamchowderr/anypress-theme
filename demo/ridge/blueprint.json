{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "AnyPress theme: Ridge demo",
		"author": "hamchowderr",
		"description": "A plumbing and heating business website built with the AnyPress theme's Ridge kit, AnyPress Blocks and Fluent Forms."
	},
	"landingPage": "/",
	"preferredVersions": { "php": "8.3", "wp": "latest" },
	"steps": [
		{ "step": "login" },
		{
			"step": "installTheme",
			"themeData": { "resource": "git:directory", "url": "https://github.com/hamchowderr/anypress-theme", "ref": "v0.5.0", "refType": "tag" },
			"options": { "activate": true, "targetFolderName": "anypress" }
		},
		{
			"step": "installPlugin",
			"pluginData": { "resource": "git:directory", "url": "https://github.com/hamchowderr/anypress-blocks", "ref": "v0.2.0", "refType": "tag" },
			"options": { "activate": true, "targetFolderName": "anypress-blocks" }
		},
		{
			"step": "installPlugin",
			"pluginData": { "resource": "wordpress.org/plugins", "slug": "fluentform" },
			"options": { "activate": true }
		},
		{
			"step": "runPHP",
			"code": "<?php require '/wordpress/wp-load.php'; require get_theme_file_path( 'demo/ridge/build.php' );"
		}
	]
}
