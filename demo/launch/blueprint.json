{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "AnyPress theme: Launch demo",
		"author": "hamchowderr",
		"description": "An example website for startup and software, built with the AnyPress theme's Launch kit, AnyPress Blocks and Fluent Forms."
	},
	"landingPage": "/",
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
