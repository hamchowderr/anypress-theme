{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "AnyPress theme: Still demo",
		"author": "hamchowderr",
		"description": "An example website for wellness, built with the AnyPress theme's Still kit, AnyPress Blocks and Fluent Forms."
	},
	"landingPage": "/",
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"steps": [
		{
			"step": "login"
		},
		{
			"step": "installTheme",
			"themeData": {
				"resource": "url",
				"url": "https://github.com/hamchowderr/anypress-theme/releases/latest/download/anypress.zip"
			},
			"options": {
				"activate": true,
				"targetFolderName": "anypress"
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://github.com/hamchowderr/anypress-blocks/releases/latest/download/anypress-blocks.zip"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "wordpress.org/plugins",
				"slug": "fluentform"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "writeFiles",
			"writeToPath": "/wordpress/wp-content/themes/anypress/demo/still",
			"filesTree": {
				"resource": "git:directory",
				"url": "https://github.com/hamchowderr/anypress-theme",
				"ref": "main",
				"refType": "branch",
				"path": "demo/still"
			}
		},
		{
			"step": "writeFile",
			"path": "/wordpress/wp-content/themes/anypress/demo/trades.php",
			"data": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/hamchowderr/anypress-theme/main/demo/trades.php"
			}
		},
		{
			"step": "runPHP",
			"code": "<?php require '/wordpress/wp-load.php'; require get_theme_file_path( 'demo/still/build.php' );"
		}
	]
}
