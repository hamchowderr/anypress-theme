{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "AnyPress theme: Aisle demo",
		"author": "hamchowderr",
		"description": "An example online clothing shop, built with the AnyPress theme's Aisle kit, AnyPress Blocks, Fluent Forms and FluentCart."
	},
	"landingPage": "/",
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"steps": [
		{
			"step": "login"
		},
		{
			"step": "installTheme",
			"themeData": {
				"resource": "url",
				"url": "https://api.anypress.io/branding/demo-files/anypress-theme.zip"
			},
			"options": {
				"activate": true,
				"targetFolderName": "anypress"
			},
			"progress": {
				"caption": "Setting up the design"
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://api.anypress.io/branding/demo-files/anypress-blocks.zip"
			},
			"options": {
				"activate": true,
				"targetFolderName": "anypress-blocks"
			},
			"progress": {
				"caption": "Adding the page sections"
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "wordpress.org/plugins",
				"slug": "fluentform"
			},
			"options": {
				"activate": true
			},
			"progress": {
				"caption": "Adding the forms"
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "wordpress.org/plugins",
				"slug": "fluent-cart"
			},
			"options": {
				"activate": true
			},
			"progress": {
				"caption": "Adding the shop"
			}
		},
		{
			"step": "installPlugin",
