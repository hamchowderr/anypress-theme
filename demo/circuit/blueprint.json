				"resource": "url",
				"url": "https://api.anypress.io/branding/demo-files/anypress-blocks.zip"
			},
			"options": {
				"activate": true,
				"targetFolderName": "anypress-blocks"
			},
			"progress": {
				"caption": "Adding the page sections"
			}
		},
