{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "AnyPress theme: Ledger demo",
		"author": "hamchowderr",
		"description": "An example website for professional services, built with the AnyPress theme's Ledger kit, AnyPress Blocks and Fluent Forms."
